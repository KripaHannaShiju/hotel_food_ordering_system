# MongoDB connection string (e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/database_name?retryWrites=true&w=majority

# Authentication Secrets & Credentials
JWT_SECRET=your_jwt_secret_key_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
KITCHEN_USERNAME=kitchen
KITCHEN_PASSWORD=kitchen123
BILLING_USERNAME=billing
BILLING_PASSWORD=billing123

# Image Upload (ImgBB API Key - Get one free at https://api.imgbb.com/)
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key_here

# Cloudinary Configs (Optional fallback)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset

# Razorpay Credentials for Payment Integration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id

# Location Guard Coordinates & Allowed Radius (optional)
NEXT_PUBLIC_RESTAURANT_LAT=9.9312
NEXT_PUBLIC_RESTAURANT_LNG=76.2673
NEXT_PUBLIC_ALLOWED_RADIUS=100
